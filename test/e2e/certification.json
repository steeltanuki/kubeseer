{
  "features": [
    {"name": "kubeseer-api-foundation", "scenarios": ["E2E-001"], "prerequisites": ["api-compatibility"]},
    {"name": "integration-testing-foundation", "scenarios": ["E2E-001"], "prerequisites": ["harness-acceptance"]},
    {"name": "resource-discovery", "scenarios": ["E2E-002", "E2E-003", "E2E-004", "E2E-007"]},
    {"name": "installation-access-policy", "scenarios": ["E2E-001", "E2E-008", "E2E-011"]},
    {"name": "resource-selection", "scenarios": ["E2E-002", "E2E-003", "E2E-004"], "prerequisites": ["resource-selection-permutations"]},
    {"name": "field-extraction", "scenarios": ["E2E-005"]},
    {"name": "typed-output-model", "scenarios": ["E2E-005", "E2E-015"]},
    {"name": "reconciliation-runtime", "scenarios": ["E2E-010", "E2E-011", "E2E-012", "E2E-013", "E2E-014"], "prerequisites": ["route-registry"]},
    {"name": "status-and-conditions", "scenarios": ["E2E-002", "E2E-007", "E2E-008", "E2E-009", "E2E-010", "E2E-011", "E2E-012", "E2E-013", "E2E-014", "E2E-015"]},
    {"name": "authorization-enforcement", "scenarios": ["E2E-008", "E2E-011", "E2E-015"]},
    {"name": "value-operators", "scenarios": ["E2E-005"]},
    {"name": "cross-namespace-aggregation", "scenarios": ["E2E-006"]},
    {"name": "admission-validation", "scenarios": ["E2E-001", "E2E-008"]},
    {"name": "observability", "scenarios": ["E2E-010", "E2E-015"], "prerequisites": ["observability-sink-failure"]},
    {"name": "performance-and-limits", "scenarios": ["E2E-009"]},
    {"name": "packaging-and-installation", "scenarios": ["E2E-001"], "prerequisites": ["package-compatibility"]}
  ],
  "minimumScenarios": [
    {"key": "deployment-in-kubeseer-namespace", "scenarios": ["E2E-002"]},
    {"key": "pods-across-multiple-namespaces", "scenarios": ["E2E-003"]},
    {"key": "custom-resource", "scenarios": ["E2E-004"]},
    {"key": "label-selection", "scenarios": ["E2E-004"]},
    {"key": "scalar-jsonpath", "scenarios": ["E2E-005"]},
    {"key": "list-jsonpath", "scenarios": ["E2E-005"]},
    {"key": "typed-values", "scenarios": ["E2E-005"]},
    {"key": "numeric-aggregation", "scenarios": ["E2E-006"]},
    {"key": "partial-degraded-result", "scenarios": ["E2E-006", "E2E-007"]},
    {"key": "forbidden-namespace", "scenarios": ["E2E-008"]},
    {"key": "forbidden-kind", "scenarios": ["E2E-008"]},
    {"key": "missing-resource-type-or-crd", "scenarios": ["E2E-007"]},
    {"key": "source-update", "scenarios": ["E2E-010"]},
    {"key": "semantic-no-op", "scenarios": ["E2E-010"]},
    {"key": "source-deletion", "scenarios": ["E2E-011"]},
    {"key": "policy-restriction", "scenarios": ["E2E-011"]},
    {"key": "operator-restart", "scenarios": ["E2E-012"]},
    {"key": "oversized-output", "scenarios": ["E2E-009"]},
    {"key": "kubeseer-deletion", "scenarios": ["E2E-013"]},
    {"key": "overlapping-instances", "scenarios": ["E2E-014"]}
  ],
  "prerequisites": [
    {"name": "api-compatibility", "command": "make test-compatibility", "expect": "API compatibility matrix passed"},
    {"name": "harness-acceptance", "command": "./hack/e2e-harness-acceptance.sh", "expect": "E2E_HARNESS_ACCEPTANCE=complete STATUS=passed"},
    {"name": "resource-selection-permutations", "command": "make test-integration", "expect": "MODULE_INTEGRATION=resource-selection STATUS=passed"},
    {"name": "route-registry", "command": "make test-integration", "expect": "MODULE_INTEGRATION=reconciliation-runtime STATUS=passed"},
    {"name": "observability-sink-failure", "command": "make test-integration", "expect": "MODULE_INTEGRATION=observability STATUS=passed"},
    {"name": "package-compatibility", "command": "make test-package-compatibility", "expect": "PACKAGE_COMPATIBILITY=complete STATUS=passed"}
  ],
  "scenarios": [
    {"id": "E2E-001", "name": "Package bootstrap and admission", "registryKey": "package-bootstrap"},
    {"id": "E2E-002", "name": "Same-namespace Deployment", "registryKey": "same-namespace-deployment"},
    {"id": "E2E-003", "name": "Multi-namespace Pods", "registryKey": "multi-namespace-pods"},
    {"id": "E2E-004", "name": "Custom Resource and labels", "registryKey": "custom-resource-labels"},
    {"id": "E2E-005", "name": "Extraction, typing, and operators", "registryKey": "extraction-typing-operators"},
    {"id": "E2E-006", "name": "Numeric aggregation", "registryKey": "numeric-aggregation"},
    {"id": "E2E-007", "name": "Missing type and partial degradation", "registryKey": "missing-type-degradation"},
    {"id": "E2E-008", "name": "Authorization denial after policy drift", "registryKey": "authorization-policy-drift"},
    {"id": "E2E-009", "name": "Resource and status limits", "registryKey": "resource-status-limits"},
    {"id": "E2E-010", "name": "Source update and semantic no-op", "registryKey": "source-update-noop"},
    {"id": "E2E-011", "name": "Source deletion and policy restriction", "registryKey": "source-deletion-policy"},
    {"id": "E2E-012", "name": "Manager restart", "registryKey": "manager-restart"},
    {"id": "E2E-013", "name": "Kubeseer deletion", "registryKey": "kubeseer-deletion"},
    {"id": "E2E-014", "name": "Overlapping instances", "registryKey": "overlapping-instances"},
    {"id": "E2E-015", "name": "Status and observability correlation", "registryKey": "status-observability"}
  ]
}
